# Copy this file to .env.local for running on your computer.
# On Vercel, add the same values under Project > Settings > Environment Variables.

# Supabase: Project Settings > API Keys (URL under Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Never commit it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay: Dashboard > Account and Settings > API Keys. Use test keys first (they start with rzp_test_).
RAZORPAY_KEY_ID=rzp_test_yourkeyid
# Secret. Never commit it.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# The secret you type when creating the webhook in Razorpay (Accounts and Settings > Webhooks).
RAZORPAY_WEBHOOK_SECRET=a-long-random-text-you-choose

# Set to "on" after Google sign-in is set up in Supabase (Authentication > Providers > Google).
NEXT_PUBLIC_GOOGLE_LOGIN=off
